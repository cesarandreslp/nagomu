# Copia este archivo a .env.local y llenalo con `vercel env pull .env.local`.
# NUNCA comitees un archivo con valores reales: el repositorio es publico.

# Conexion agrupada de Neon. La usa la aplicacion en tiempo de ejecucion.
DATABASE_URL="postgresql://usuario:clave@host-pooler.region.aws.neon.tech/nagomu?sslmode=require"

# Conexion directa de Neon, sin agrupador. La usan las migraciones de Prisma.
# `connect_timeout=30` es necesario: Neon suspende el computo tras unos minutos de
# inactividad y el arranque en frio supera el tiempo de espera por defecto de Prisma,
# que falla con P1001 aunque el servidor este perfectamente accesible.
DIRECT_URL="postgresql://usuario:clave@host.region.aws.neon.tech/nagomu?sslmode=require&connect_timeout=30"

# Almacenamiento de documentos de respaldo (Vercel Blob). Se obtiene creando un store
# en el proyecto de Vercel: Storage -> Create -> Blob. Sin esta variable la aplicacion
# funciona, pero no permite adjuntar archivos y lo dice en pantalla.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# No hay secreto de cookie. El identificador de sesion son 256 bits del generador
# criptografico del sistema y solo sirve si existe la fila correspondiente en la
# tabla Sesion, asi que no hay nada que firmar. Borrar esa fila revoca el acceso.
