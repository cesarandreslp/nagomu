// Esquema de nagomu. Las URLs viven en prisma.config.ts (Prisma 7).
// Modelo de datos: specs/001-cofinanciacion-obras/data-model.md

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NivelTerritorial {
  MUNICIPIO
  DEPARTAMENTO
  NACION
}

enum TipoActor {
  ENTIDAD_TERRITORIAL
  EMPRESA
  FUNDACION
  ONG
  VOLUNTARIADO
  PERSONA_NATURAL
  COOPERANTE_INTERNACIONAL
}

enum ResultadoAccion {
  PERMITIDO
  RECHAZADO
}

/// Determina el nivel de prioridad. El nivel no se almacena: se deriva de la
/// categoria en lib/prioridad.ts, asi no puede quedar desincronizado ni editarse
/// a mano para colar una obra mas arriba de lo que le corresponde.
enum CategoriaItem {
  /// Nivel 0. Alimentacion, agua potable, alojamiento. Sin uso en esta version:
  /// la atencion humanitaria recurrente tiene ciclo de vida propio.
  SUBSISTENCIA

  // Nivel 1: riesgo activo
  MITIGACION_RIESGO
  ESTRUCTURA_EN_RIESGO

  // Nivel 2: servicios esenciales
  SALUD
  ACUEDUCTO
  VIA_UNICA_ACCESO

  // Nivel 3: educacion
  EDUCACION

  // Nivel 4: productivo
  PRODUCTIVO
  VIA_SECUNDARIA

  // Nivel 5: cultural y recreativo
  CULTURAL
  RECREATIVO
}

enum EstadoObra {
  IDENTIFICADO
  EN_ESTUDIOS
  COSTEADO
  EN_EJECUCION
  ENTREGADA
}

/// Nivel al que pertenece un fondo. EXTERNO cubre lo que no es del Estado
/// colombiano: banca multilateral, cooperacion bilateral, donacion privada.
enum AmbitoFondo {
  MUNICIPAL
  DEPARTAMENTAL
  NACIONAL
  EXTERNO
}

/// De donde sale realmente la plata. Determina que se le exige al aporte.
enum NaturalezaFondo {
  /// Recursos propios de la entidad, sin condicion adicional.
  PROPIO
  /// Se sacrifica un proyecto ya presupuestado. Exige decir cual.
  TRASLADO_PRESUPUESTAL
  /// Fondo especial de gestion del riesgo (FNGRD, FDGRD, FMGRD).
  FONDO_GESTION_RIESGO
  /// Endeudamiento, incluida la banca multilateral.
  CREDITO
  /// Sistema General de Regalias.
  REGALIAS
  /// Transferencias de la nacion a los territorios (SGP).
  TRANSFERENCIA
  /// Cooperacion internacional no reembolsable.
  COOPERACION_INTERNACIONAL
  /// Donacion privada o de gremios.
  DONACION
  /// El aportante ejecuta la obra en lugar de girar dinero (obras por impuestos).
  EJECUCION_EN_ESPECIE
}

/// Que clase de ayuda es. Determina en que parte de la ruta de atencion aparece.
enum TipoOferta {
  ALOJAMIENTO_TEMPORAL
  ALIMENTACION_Y_KITS
  SALUD
  INDEMNIZACION
  VIVIENDA
  EVALUACION_TECNICA
  EMPLEO_E_INGRESOS
  NIÑEZ_Y_FAMILIA
  ALIVIO_FINANCIERO
  ALIVIO_TRIBUTARIO
  SERVICIOS_PUBLICOS
}

/// A quien va dirigida la ayuda.
enum DestinatarioOferta {
  HOGAR
  PERSONA
  EMPRESA
  ENTIDAD_TERRITORIAL
}

/// Muchas medidas se anuncian en rueda de prensa y se reglamentan semanas despues.
/// Mostrar una ayuda anunciada como si estuviera disponible manda a una familia a
/// hacer una fila que no existe.
enum EstadoOferta {
  VIGENTE
  ANUNCIADO
  CERRADO
}

/// Oferta institucional: que ofrece cada entidad a los damnificados.
///
/// No es dinero para obras —eso es `Fondo`— sino ayuda a personas y hogares. Se
/// cataloga porque hoy esta dispersa entre ministerios, entidades adscritas,
/// organismos de socorro y el sector privado, y una familia no tiene forma de saber
/// que le corresponde ni quien se lo certifica.
model OfertaInstitucional {
  id     String @id @default(cuid())
  nombre String

  /// Quien ofrece: UNGRD, Ministerio de Vivienda, ADRES, Cruz Roja, Asobancaria.
  entidad String

  /// Nivel de la entidad que ofrece. EXTERNO cubre organismos de socorro,
  /// cooperacion y sector privado.
  ambito AmbitoFondo

  tipo         TipoOferta
  destinatario DestinatarioOferta
  estado       EstadoOferta       @default(ANUNCIADO)

  descripcion String

  /// Que se necesita para acceder. La respuesta suele ser una certificacion de
  /// alguien mas, y ahi es donde la ayuda se atasca.
  requisito String

  /// El Registro Unico de Damnificados es la puerta de entrada a casi todo. Si un
  /// hogar no esta inscrito, no accede aunque tenga derecho.
  requiereRud Boolean @default(false)

  /// Quien expide la certificacion que habilita el acceso, cuando aplica.
  certificaEntidad String?

  canal String?
  monto String?
  norma String?

  creadoEn DateTime @default(now())

  @@unique([entidad, nombre])
  @@index([tipo])
  @@index([estado])
  @@index([ambito])
}

/// Catalogo de fuentes de financiacion reales, con su ambito y su norma.
///
/// Reemplaza al enum de origen que se habia planeado. Un enum plano no distingue
/// el FNGRD del FMGRD ni sabe que un municipio no puede gastar del fondo nacional:
/// el ambito de cada fondo hace que la interfaz solo ofrezca lo que a esa entidad
/// le corresponde, y que la auditoria diga de que fondo concreto salio cada peso.
model Fondo {
  id     String      @id @default(cuid())
  nombre String
  sigla  String?     @unique
  ambito AmbitoFondo

  naturaleza NaturalezaFondo

  /// Quien lo administra: UNGRD, gobernacion, alcaldia, Banco Mundial.
  administrador String

  /// Norma o acto que lo crea. Es lo que permite auditar que el fondo existe.
  norma String?

  descripcion String

  /// Un traslado presupuestal obliga a declarar que proyecto se aplazo (FR-017).
  exigeProyectoAplazado Boolean @default(false)

  /// Los fondos no se borran: dejan de estar vigentes. La historia de aportes
  /// pasados tiene que seguir siendo legible.
  vigente Boolean @default(true)

  creadoEn DateTime @default(now())

  @@index([ambito])
  @@index([vigente])
}

/// Municipio, gobernacion o nacion. Un municipio apunta a su gobernacion.
model EntidadTerritorial {
  id             String              @id @default(cuid())
  nombre         String
  nivel          NivelTerritorial
  departamentoId String?
  departamento   EntidadTerritorial? @relation("MunicipiosDelDepartamento", fields: [departamentoId], references: [id], onDelete: Restrict)
  municipios     EntidadTerritorial[] @relation("MunicipiosDelDepartamento")

  /// Indice de vulnerabilidad del municipio, 0 a 100. Alimenta el puntaje de prioridad.
  nbi        Decimal? @db.Decimal(5, 2)
  codigoDane String?  @unique

  usuarios  Usuario[]
  actor     Actor?
  auditoria RegistroAuditoria[]
  items     ItemInventario[]
  creadoEn  DateTime            @default(now())

  @@index([nivel])
  @@index([departamentoId])
}

/// Edificacion, zona o necesidad afectada. Pertenece a un solo municipio.
/// Concentra los datos que alimentan el puntaje de prioridad.
model ItemInventario {
  id          String             @id @default(cuid())
  municipioId String
  municipio   EntidadTerritorial @relation(fields: [municipioId], references: [id], onDelete: Restrict)

  nombre           String
  /// Descriptiva. Sin coordenadas en esta version.
  ubicacion        String
  categoria        CategoriaItem
  descripcionDano  String

  /// Nulo permitido: la obra queda con puntaje incompleto y al final de su nivel,
  /// pero no desaparece de la lista.
  personasBeneficiadas Int?
  mesesFueraDeServicio Int  @default(0)

  obra     Obra?
  creadoEn DateTime @default(now())

  @@index([municipioId])
  @@index([categoria])
}

/// Lo que hay que hacer sobre un item. Uno a uno con el item en esta version.
model Obra {
  id     String         @id @default(cuid())
  itemId String         @unique
  item   ItemInventario @relation(fields: [itemId], references: [id], onDelete: Restrict)

  estado EstadoObra @default(IDENTIFICADO)

  /// Cotizacion de los estudios. Se conoce antes que el costo de la obra, porque es
  /// una cotizacion y no un resultado. Son dos cifras distintas y no deben mezclarse.
  costoEstudios Decimal? @db.Decimal(18, 2)

  costos  CostoObra[]
  cambios CambioEstadoObra[]

  creadoEn DateTime @default(now())

  @@index([estado])
}

/// Valor de la obra entregado por un estudio. Inmutable.
///
/// El costo de una obra no existe hasta que un estudio lo determina. Cuando un
/// estudio posterior lo actualiza no se sobrescribe: se agrega una fila nueva y la
/// anterior queda en el historial. El vigente es el mas reciente no corregido.
model CostoObra {
  id     String @id @default(cuid())
  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Restrict)

  valor       Decimal  @db.Decimal(18, 2)
  fechaEstudio DateTime

  /// Documento que respalda el valor. Sin respaldo, la cifra no es auditable.
  referenciaDocumento String
  /// Quien hizo el estudio.
  responsable String

  registradoPorId String
  registradoPor   Usuario @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  /// Apunta al costo que corrige. Una correccion es una fila nueva, nunca un UPDATE.
  corrigeId String?    @unique
  corrige   CostoObra? @relation("CorreccionCosto", fields: [corrigeId], references: [id], onDelete: Restrict)
  corregidoPor CostoObra? @relation("CorreccionCosto")

  creadoEn DateTime @default(now())

  @@index([obraId, creadoEn])
}

/// Asiento inmutable de cada transicion de estado de una obra.
model CambioEstadoObra {
  id     String @id @default(cuid())
  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Restrict)

  estadoAnterior EstadoObra
  estadoNuevo    EstadoObra
  motivo         String?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  creadoEn DateTime @default(now())

  @@index([obraId, creadoEn])
}

/// Funcionario. Actua siempre en nombre de una entidad territorial.
model Usuario {
  id             String   @id @default(cuid())
  correo         String   @unique
  nombre         String
  /// scrypt, con sal y parametros embebidos. Nunca la contrasena en claro.
  hashContrasena String
  entidadId      String
  entidad        EntidadTerritorial @relation(fields: [entidadId], references: [id], onDelete: Restrict)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())

  sesiones       Sesion[]
  auditoria      RegistroAuditoria[]
  costosObra     CostoObra[]
  cambiosEstado  CambioEstadoObra[]

  @@index([entidadId])
}

/// Sesion opaca. Su id viaja en la cookie. Es la unica tabla donde se permite DELETE:
/// borrar la fila revoca el acceso de inmediato.
model Sesion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn  DateTime @default(now())
  expiraEn  DateTime

  @@index([usuarioId])
  @@index([expiraEn])
}

/// Quien participa en una obra. Solo las entidades territoriales tienen usuario propio.
model Actor {
  id     String    @id @default(cuid())
  tipo   TipoActor
  nombre String

  /// Un solo dato de contacto. De una persona natural no se guarda nada mas
  /// (Principio IV de la constitucion: minimo de datos personales).
  contacto String?

  entidadId String?             @unique
  entidad   EntidadTerritorial? @relation(fields: [entidadId], references: [id], onDelete: Restrict)
  creadoEn  DateTime            @default(now())

  @@index([tipo])
}

/// Asiento inmutable de cada hecho del sistema, incluidos los intentos rechazados.
/// Un disparador de Postgres rechaza UPDATE y DELETE sobre esta tabla.
model RegistroAuditoria {
  id        String              @id @default(cuid())
  usuarioId String?
  usuario   Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  entidadId String?
  entidad   EntidadTerritorial? @relation(fields: [entidadId], references: [id], onDelete: Restrict)
  nivel     NivelTerritorial?

  /// Verbo canonico: `obra.crear`, `aporte.registrar`, `intervencion.aprobar`.
  accion       String
  objetivoTipo String
  objetivoId   String?

  resultado     ResultadoAccion
  motivoRechazo String?

  /// Instantanea de lo relevante. NUNCA datos personales.
  datos Json

  creadoEn DateTime @default(now())

  @@index([objetivoTipo, objetivoId])
  @@index([creadoEn])
  @@index([usuarioId])
}
